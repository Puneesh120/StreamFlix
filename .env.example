# STREAMFLIX Environment Variables Example
# Copy this file to your deployment environment or set these in your hosting dashboard.
# DO NOT commit real API keys into version control.

# Required: Your OMDb API Key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=YOUR_OMDB_API_KEY

# Optional: Server port (defaults to 8080)
PORT=8080

# Optional: Allowed CORS origins if frontend is deployed separately (comma-separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080
